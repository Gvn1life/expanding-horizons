# Google Cloud service account used to write leads to your Google Sheet.
# Create at console.cloud.google.com -> IAM & Admin -> Service Accounts -> Keys -> Add Key (JSON).
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# The target spreadsheet's ID, from its URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
GOOGLE_SHEET_ID=

# For website lookups (Google Custom Search JSON API — free tier: 100 queries/day).
# Enable "Custom Search API" in the same Cloud project, create a key under Credentials,
# and create a search engine at programmablesearchengine.google.com set to "search the
# entire web" to get the engine ID (cx).
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=
